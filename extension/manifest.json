{
  "manifest_version": 3,
  "name": "Goon Guard",
  "version": "0.1.0",
  "description": "Blocks adult sites, alerts your accountability partner, and tracks your streak.",
  "permissions": ["storage", "webNavigation", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Goon Guard" },
  "options_page": "options.html",
  "web_accessible_resources": [{ "resources": ["block.html"], "matches": ["<all_urls>"] }]
}
